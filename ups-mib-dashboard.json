{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "VAL_DEFAULT_GRID_VOLTAGE",
      "label": "Default Grid Voltage (only 120 or 220 are supported)",
      "description": "Fallback grid voltage when auto-detection fails (120 or 220)",
      "type": "constant",
      "value": "120"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus"
    }
  ],
  "title": "UPS Monitor (RFC 1628 UPS-MIB)",
  "description": "Generic UPS monitoring dashboard based on IETF RFC 1628 UPS-MIB, compatible with any UPS via Prometheus snmp_exporter. Author: lutianyu2001.",
  "tags": [
    "ups",
    "snmp",
    "ups-mib",
    "rfc1628"
  ],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(upsBatteryStatus, job)",
        "includeAll": false,
        "label": "Job Name",
        "name": "JobName",
        "options": [],
        "query": {
          "query": "label_values(upsBatteryStatus, job)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result(upsBatteryStatus{job=~'$JobName'})",
        "includeAll": false,
        "label": "Device",
        "name": "Device",
        "options": [],
        "query": {
          "query": "query_result(upsBatteryStatus{job=~'$JobName'})",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": ".*instance=\"(.*?)\".*",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "${VAL_DEFAULT_GRID_VOLTAGE}",
          "value": "${VAL_DEFAULT_GRID_VOLTAGE}"
        },
        "hide": 2,
        "label": "Default Grid Voltage",
        "name": "DefaultGridVoltage",
        "query": "${VAL_DEFAULT_GRID_VOLTAGE}",
        "type": "constant"
      },
      {
        "current": {
          "selected": true,
          "text": "Auto",
          "value": "0"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Grid Voltage",
        "name": "GridVoltageMode",
        "options": [
          {
            "selected": true,
            "text": "Auto",
            "value": "0"
          },
          {
            "selected": false,
            "text": "120V",
            "value": "120"
          },
          {
            "selected": false,
            "text": "220V",
            "value": "220"
          }
        ],
        "query": "Auto : 0,120V : 120,220V : 220",
        "type": "custom"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result((vector($GridVoltageMode) > 0) or ((max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) >= 108) and (max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) <= 132)) * 0 + 120 or ((max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) >= 198) and (max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) <= 242)) * 0 + 220 or vector($DefaultGridVoltage))",
        "hide": 2,
        "includeAll": false,
        "label": "Grid Voltage (Resolved)",
        "name": "GridVoltage",
        "query": {
          "query": "query_result((vector($GridVoltageMode) > 0) or ((max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) >= 108) and (max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) <= 132)) * 0 + 120 or ((max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) >= 198) and (max(avg_over_time(upsInputVoltage{instance=~'$Device',job=~'$JobName'}[1h])) <= 242)) * 0 + 220 or vector($DefaultGridVoltage))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "/\\}\\s+(\\d+)\\s/",
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "uid": "ups-mib-rfc1628",
